# Copy this file to .env for local runs. Never commit the real .env.
# In production these same values live in GitHub Actions Secrets (see SETUP.md).

# Claude API — script/idea generation
ANTHROPIC_API_KEY=

# Pexels — primary stock video source (free, https://www.pexels.com/api/)
PEXELS_API_KEY=
# Pixabay — fallback stock video source (free, https://pixabay.com/api/docs/)
PIXABAY_API_KEY=

# Amazon Polly — voiceover + word-level caption timing
# Free tier: 5M characters/month for the first 12 months. https://aws.amazon.com/polly/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# YouTube OAuth — see SETUP.md for how to get all three of these
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# ntfy.sh topic for alerts — pick something obscure, it's not secret but
# anyone who knows the topic name can read your alerts. Optional; if unset,
# alerts just print to the log instead.
NTFY_TOPIC=

# Safety knobs
MAX_VIDEOS_PER_DAY=1
CHANNEL_NAME=WealthSignals
